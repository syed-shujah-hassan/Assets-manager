# Copy to .env for local dev. On Vercel use Environment Variables (REACT_APP_ prefix only).
REACT_APP_BACKEND_URL=http://localhost:5000

# Same key as EXPO_PUBLIC_GOOGLE_MAPS_API_KEY in the mobile app (one Cloud project is fine).
# In Google Cloud Console (same project as this key), enable billing and these APIs:
#   - Maps Embed API  → required for the admin "route" iframe (maps/embed/v1/directions)
#   - Directions API  → required for react-native-maps-directions / MapViewDirections
#   - Maps SDK for Android / Maps SDK for iOS → if you use Google maps tiles on devices
# Library: https://console.cloud.google.com/google/maps-apis/api-list
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_key
